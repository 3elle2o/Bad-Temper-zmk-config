#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 30
#define MOUSE_TIME_TO_MAX_SPEED 300

#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/behaviors.h>
#include <behaviors/num_word.dtsi>
#include <input/processors.dtsi>
#include "keys_it.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&num_word { continue-list = <LPAR RPAR EQUAL SLASH MINUS ASTRK PLUS PRCNT COMMA DOT>; };
&caps_word { continue-list = <SPACE BSPC>; };

&mt {
    tapping-term-ms = <150>;
    flavor = "tap-preferred";
};

/ {
    macros {
        passpc: passpc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N0 &kp N3 &kp N1 &kp N1>;
        };

        passfirma: passfirma {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N7 &kp N3 &kp N0 &kp N0 &kp N2 &kp N0 &kp N9 &kp N9>;
        };
    };

    nav_word: nav_word {
        compatible = "zmk,behavior-auto-layer";
        #binding-cells = <1>;
        continue-list = <UP LEFT_ALT LEFT_GUI LEFT_CONTROL LEFT_SHIFT LEFT RIGHT TAB DOWN>;
        ignore-modifiers;
    };

    mau_word: mau_word {
        compatible = "zmk,behavior-auto-layer";
        #binding-cells = <1>;
        continue-list = <LCLK RCLK MCLK>;
        ignore-modifiers;
    };

    behaviors {
        modificatori: modificatori {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            bindings = <&sk>, <&kp>;
            display-name = "modificatori";
            flavor = "tap-preferred";
        };

        schiftnum: schiftnum {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "SCHIFTNUM";
            bindings = <&mo>, <&sk>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
        };

        simb_frecce: simb_frecce {
            compatible = "zmk,behavior-tap-dance";
            label = "SIMB_FRECCE";
            #binding-cells = <0>;
            bindings = <&sl 3>, <&nav_word 1>;
            tapping-term-ms = <250>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_backspace {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&kp BSPC>;
        };

        combo_space {
            timeout-ms = <60>;
            key-positions = <12 13>;
            bindings = <&kp SPACE>;
        };

        combo_enter {
            timeout-ms = <50>;
            key-positions = <22 23>;
            bindings = <&kp ENTER>;
        };

        apostrofo {
            bindings = <&kp APOS>;
            key-positions = <16 17 18>;
        };

        numeri {
            bindings = <&num_word 2>;
            key-positions = <17 27>;
        };

        entersx {
            bindings = <&kp ENTER>;
            key-positions = <27 26>;
            timeout-ms = <50>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "QWERTY";
            bindings = <
&kp Q                  &kp W  &kp E  &kp R           &kp T                                               &kp Y        &kp U  &kp I      &kp O       &caps_word
&kp A                  &kp S  &kp D  &kp F           &kp G                                               &kp H        &kp J  &kp K      &kp L       &kp P  
&modificatori LCTRL Z  &kp X  &kp C  &kp V           &kp B                                               &kp N        &kp M  &kp COMMA  &kp DOT     &kp ESC  
                                     &mau_word 4     &kp DEL  &schiftnum 2 LEFT_SHIFT      &simb_frecce  &kp TAB      &mo 5  
            >;
        };

        FRECCE {
            display-name = "OPZIONI";
            bindings = <
&trans        &trans        &trans            &trans          &trans                       &trans  &trans          &kp UP     &trans  &trans
&kp LEFT_ALT  &kp LEFT_GUI  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &trans                       &trans  &kp LEFT_ARROW  &kp RIGHT  &trans  &trans
&trans        &trans        &trans            &trans          &trans                       &trans  &trans          &kp DOWN   &trans  &trans   
                                              &trans          &trans  &trans       &trans  &trans  &trans
            >;
        };

        NUMBER {
            display-name = "NUMERI";
            bindings = <
&kp ASTRK  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp SLASH                       &trans  &trans  &trans  &trans  &trans  
&kp COMMA   &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp MINUS                       &trans  &trans  &trans  &trans  &trans  
&kp N0  &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp PLUS                       &trans  &trans  &trans  &trans  &trans  
                                 &kp DOT    &kp EQUAL      &trans      &trans  &trans  &trans
            >;
        };

        SIMBOLI {
            display-name = "SIMBOLI";
            bindings = <
&kp DOLLAR  &kp LESS_THAN     &kp LEFT_BRACE   &kp LBKT           &kp SLASH                          &kp EXCL  &kp COLON  &kp SEMI  &kp QUESTION  &passpc
&kp HASH    &kp GREATER_THAN  &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &kp AMPS                           &kp DQT   &kp LPAR   &kp RPAR  &kp UNDER     &passfirma  
&kp CARET   &kp PIPE          &kp BSLH         &kp PERCENT        &kp F2                             &none     &kp AT     &kp HOME  &none         &kp PRINTSCREEN
                                               &trans             &trans    &trans           &trans  &trans    &trans
            >;
        };

        MOUSE {
            display-name = "MOUSE";
            bindings = <
&trans          &trans     &trans     &trans        &trans                                          &trans      &trans     &trans  &trans  &trans 
&trans          &mkp RCLK  &mkp MCLK  &mkp LCLK     &caps_word                                      &trans      &trans     &trans  &trans  &trans  
&trans          &trans     &trans     &trans        &trans                                          &caps_word  &trans     &trans  &trans  &trans  
                                      &trans        &trans         &trans                &mkp LCLK  &mkp MCLK   &mkp RCLK
            >;
        };

        MEDIA {
            display-name = "MEDIA";
            bindings = <
&kp C_VOL_UP      &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans  
&kp C_PLAY_PAUSE  &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans  
&kp K_VOL_DN      &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans  
                                  &trans  &trans  &trans       &trans  &trans  &trans  
            >;
        };
    };
};
