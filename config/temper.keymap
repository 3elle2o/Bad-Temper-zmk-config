#define ZMK_POINTING_DEFAULT_MOVE_VAL 1600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 30
#define MOUSE_TIME_TO_MAX_SPEED 300

#include <dt-bindings/zmk/behaviors.h>
#include <behaviors/num_word.dtsi>
#include <input/processors.dtsi>
#include "keys_it.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&num_word { continue-list = <LPAR RPAR EQUAL SLASH MINUS ASTRK PLUS PRCNT COMMA DOT>; };

&caps_word { continue-list = <SPACE BSPC>; };

&mt {
    tapping-term-ms = <150>;
    flavor = "tap-preferred";
};

/ {
    macros {
        passpc: passpc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N0 &kp N3 &kp N1 &kp N1>;
        };

        passfirma: passfirma {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N7 &kp N3 &kp N0 &kp N0 &kp N2 &kp N0 &kp N9 &kp N9>;
        };
    };

    nav_word: nav_word {
        compatible = "zmk,behavior-auto-layer";
        #binding-cells = <1>;
        continue-list = <UP LEFT_ALT LEFT_GUI LEFT_CONTROL LEFT_SHIFT LEFT RIGHT TAB DOWN>;
        ignore-modifiers;
    };

    mau_word: mau_word {
        compatible = "zmk,behavior-auto-layer";
        #binding-cells = <1>;
        continue-list = <RCLK MCLK LCLK MOVE_LEFT MOVE_RIGHT MOVE_UP>;
        ignore-modifiers;
    };

    behaviors {
        modificatori: modificatori {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            bindings = <&sk>, <&kp>;

            display-name = "modificatori";
            flavor = "tap-preferred";
        };

        schiftnum: schiftnum {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "SCHIFTNUM";
            bindings = <&mo>, <&sk>;

            tapping-term-ms = <150>;
            flavor = "tap-preferred";
        };

        simb_frecce: simb_frecce {
            compatible = "zmk,behavior-tap-dance";
            label = "SIMB_FRECCE";
            #binding-cells = <0>;
            bindings = <&sl 3>, <&nav_word 1>;

            tapping-term-ms = <250>;
        };

        mai_mau: mai_mau {
            compatible = "zmk,behavior-tap-dance";
            label = "MAI_MAU";
            #binding-cells = <0>;
            bindings = <&caps_word>, <&none>;

            tapping-term-ms = <250>;
        };

        mau_tab: mau_tab {
            compatible = "zmk,behavior-tap-dance";
            label = "MAU_TAB";
            #binding-cells = <0>;
            bindings = <&kp TAB>, <&mau_word 4>;

            tapping-term-ms = <200>;
        };
    };

    combos {
        compatible = "zmk,combos";

        bks {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&kp BSPC>;
        };

        spc {
            timeout-ms = <60>;
            key-positions = <12 13>;
            bindings = <&kp SPACE>;
        };

        ent {
            timeout-ms = <50>;
            key-positions = <22 23>;
            bindings = <&kp ENTER>;
        };

        apo {
            bindings = <&kp APOS>;
            key-positions = <16 17 18>;
        };

        num {
            bindings = <&num_word 2>;
            key-positions = <25 15>;
        };

        ent2 {
            bindings = <&kp ENTER>;
            key-positions = <27 26>;
            timeout-ms = <50>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "QWERTY";
            bindings = <
&kp Q  &kp UP    &kp E    &kp R      &kp T                    &caps_word    &kp U         &kp I         &kp O    &kp ESC
&kp A  &kp S     &kp D    &kp F      &kp G                    &kp H         &kp LEFT      &kp RIGHT     &kp L    &kp P
&kp Z  &kp DOWN  &kp C    &kp V      &kp B                    &kp N         &kp M         &kp COMMA     &kp DOT  &mau_tab
                 &kp DEL  &sk RCTRL  &schiftnum 2 LEFT_SHIFT  &simb_frecce  &sk LEFT_ALT  &sk LEFT_GUI
            >;
        };

        FRECCE {
            display-name = "FRECCE";
            bindings = <
&trans  &kp W   &trans     &trans     &trans     &kp Y   &trans  &trans  &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans  &kp J   &kp K   &trans  &trans
&trans  &kp X   &kp LC(X)  &kp LC(C)  &kp LC(V)  &trans  &trans  &trans  &trans  &trans
                &trans     &trans     &trans     &trans  &trans  &trans
            >;
        };

        NUMBER {
            display-name = "NUMERI";
            bindings = <
&trans  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp DOT    &trans     &trans     &trans     &trans     &trans
&trans  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp COMMA  &kp EQUAL  &kp SLASH  &kp ASTRK  &kp MINUS  &kp PLUS
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp N0     &trans     &trans     &trans     &trans     &trans
                      &trans        &trans        &trans     &trans     &trans     &trans
            >;
        };

        SIMBOLI {
            display-name = "SIMBOLI";
            bindings = <
&none      &kp LESS_THAN     &kp LEFT_BRACE   &kp LBKT           &kp DOLLAR  &kp EXCL   &kp COLON  &kp SEMI  &kp QUESTION  &passpc
&none      &kp GREATER_THAN  &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &kp AMPS    &kp DQT    &kp LPAR   &kp RPAR  &kp UNDER     &passfirma
&kp CARET  &kp PIPE          &kp BSLH         &kp HASH           &kp F2      &kp SLASH  &kp AT     &kp HOME  &kp PERCENT   &kp PRINTSCREEN
                             &trans           &trans             &trans      &trans     &trans     &trans
            >;
        };

        MOUSE {
            display-name = "MOUSE";
            bindings = <
&trans  &trans     &trans     &trans     &trans  &trans  &trans          &mmv MOVE_UP    &trans           &trans
&trans  &mkp RCLK  &mkp MCLK  &mkp LCLK  &trans  &trans  &mmv MOVE_LEFT  &trans          &mmv MOVE_RIGHT  &trans
&trans  &trans     &trans     &trans     &trans  &trans  &trans          &mmv MOVE_DOWN  &trans           &trans
                   &trans     &trans     &trans  &trans  &trans          &trans
            >;
        };
    };
};
