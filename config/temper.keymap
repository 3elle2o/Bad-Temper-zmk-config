#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 30
#define MOUSE_TIME_TO_MAX_SPEED 300

#include <dt-bindings/zmk/behaviors.h>
#include <behaviors/num_word.dtsi>
#include <input/processors.dtsi>
#include "keys_it.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&num_word { continue-list = <LPAR RPAR EQUAL SLASH MINUS ASTRK PLUS PRCNT COMMA DOT>; };

&caps_word { continue-list = <SPACE BSPC>; };

&mt {
    tapping-term-ms = <150>;
    flavor = "tap-preferred";
};

/ {
    macros {
        passpc: passpc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N0 &kp N3 &kp N1 &kp N1>;
        };

        passfirma: passfirma {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N7 &kp N3 &kp N0 &kp N0 &kp N2 &kp N0 &kp N9 &kp N9>;
        };
    };

    nav_word: nav_word {
        compatible = "zmk,behavior-auto-layer";
        #binding-cells = <1>;
        continue-list = <UP LEFT_ALT LEFT_GUI LEFT_CONTROL LEFT_SHIFT LEFT RIGHT TAB DOWN>;
        ignore-modifiers;
    };

    mau_word: mau_word {
        compatible = "zmk,behavior-auto-layer";
        #binding-cells = <1>;
        continue-list = <LCLK RCLK MCLK>;
        ignore-modifiers;
    };

    behaviors {
        modificatori: modificatori {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            bindings = <&sk>, <&kp>;

            display-name = "modificatori";
            flavor = "tap-preferred";
        };

        schiftnum: schiftnum {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "SCHIFTNUM";
            bindings = <&mo>, <&sk>;

            tapping-term-ms = <150>;
            flavor = "tap-preferred";
        };

        simb_frecce: simb_frecce {
            compatible = "zmk,behavior-tap-dance";
            label = "SIMB_FRECCE";
            #binding-cells = <0>;
            bindings = <&sl 3>, <&nav_word 1>;

            tapping-term-ms = <250>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_backspace {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&kp BSPC>;
        };

        combo_space {
            timeout-ms = <60>;
            key-positions = <12 13>;
            bindings = <&kp SPACE>;
        };

        combo_enter {
            timeout-ms = <50>;
            key-positions = <22 23>;
            bindings = <&kp ENTER>;
        };

        apostrofo {
            bindings = <&kp APOS>;
            key-positions = <16 17 18>;
        };

        numeri {
            bindings = <&num_word 2>;
            key-positions = <25 15>;
        };

        entersx {
            bindings = <&kp ENTER>;
            key-positions = <27 26>;
            timeout-ms = <50>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <14 24>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "QWERTY";
            bindings = <
&kp Q  &kp W  &kp E    &kp R      &kp T                    &kp Y         &kp U       &kp I      &kp O    &mau_word
&kp A  &kp S  &kp D    &kp F      &kp G                    &kp H         &kp J       &kp K      &kp L    &kp P
&kp Z  &kp X  &kp C    &kp V      &kp B                    &kp N         &kp M       &kp COMMA  &kp DOT  &kp ESC
              &kp DEL  &sk RCTRL  &schiftnum 2 LEFT_SHIFT  &simb_frecce  &caps_word  &kp TAB
            >;
        };

        FRECCE {
            display-name = "OPZIONI";
            bindings = <
&trans        &trans        &trans            &trans          &trans  &trans  &trans          &kp UP     &trans  &trans
&kp LEFT_ALT  &kp LEFT_GUI  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &trans  &trans  &kp LEFT_ARROW  &kp RIGHT  &trans  &trans
&trans        &trans        &trans            &trans          &trans  &trans  &trans          &kp DOWN   &trans  &trans
                            &trans            &trans          &trans  &trans  &trans          &trans
            >;
        };

        NUMBER {
            display-name = "NUMERI";
            bindings = <
&trans  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp DOT    &trans     &trans     &trans     &trans     &trans
&trans  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp COMMA  &kp EQUAL  &kp SLASH  &kp ASTRK  &kp MINUS  &kp PLUS
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp N0     &trans     &trans     &trans     &trans     &trans
                      &trans        &trans        &trans     &trans     &trans     &trans
            >;
        };

        SIMBOLI {
            display-name = "SIMBOLI";
            bindings = <
&none      &kp LESS_THAN     &kp LEFT_BRACE   &kp LBKT           &kp DOLLAR  &kp EXCL   &kp COLON  &kp SEMI  &kp QUESTION  &passpc
&none      &kp GREATER_THAN  &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &kp AMPS    &kp DQT    &kp LPAR   &kp RPAR  &kp UNDER     &passfirma
&kp CARET  &kp PIPE          &kp BSLH         &kp HASH           &kp F2      &kp SLASH  &kp AT     &kp HOME  &kp PERCENT   &kp PRINTSCREEN
                             &trans           &trans             &trans      &trans     &trans     &trans
            >;
        };

        MOUSE {
            display-name = "MOUSE";
            bindings = <
&trans  &trans     &trans     &trans     &trans          &trans  &trans  &trans  &trans     &trans
&trans  &mkp RCLK  &mkp MCLK  &mkp LCLK  &trans          &trans  &trans  &trans  &trans     &trans
&trans  &trans     &trans     &trans     &trans          &trans  &trans  &trans  &mkp RCLK  &mkp LCLK
                   &trans     &kp RCTRL  &kp LEFT_SHIFT  &trans  &trans  &trans
            >;
        };
    };
};
