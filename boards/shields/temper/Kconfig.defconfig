if SHIELD_TEMPER_LEFT || SHIELD_TEMPER_RIGHT || SHIELD_TEMPER_DONGLE

config ZMK_KEYBOARD_NAME
    default "temper"

endif

if SHIELD_TEMPER_LEFT

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

if SHIELD_TEMPER_DONGLE

config ZMK_SPLIT
    default y

# NOTA: Questa è la variabile fondamentale per il Dongle
config ZMK_SPLIT_BLE_ROLE_CENTRAL
    default y

config ZMK_SPLIT_BLE_CENTRAL_SPLIT_PERIPHERALS
    default 2

config BT_MAX_CONN
    default 7

config BT_MAX_PAIRED
    default 7

endif
